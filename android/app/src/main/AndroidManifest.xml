<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 1. إذن الاتصال بالإنترنت لتشغيل محرك بحث جوجل المدمج -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>

    <!-- 2. إذن الميكروفون لتحويل الصوت والكلام إلى نص -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>

    <!-- 3. إذن الأمان، البصمة، وقفل الجهاز للمذكرات المحمية -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC"/>
    <uses-permission android:name="android.permission.USE_FINGERPRINT"/>

    <!-- 4. أذونات الوصول للصور وتعيين الخلفيات (للإصدارات القديمة والحديثة) -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES"/>

    <!-- مهم جداً لأندرويد 11 فما فوق: للسماح للتطبيق بالوصول لمحرك تحويل الصوت التابع لجوجل -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:requestLegacyExternalStorage="true"
        android:label="مذكراتي"
        android:icon="@drawable/ic_launcher"
        android:theme="@style/NormalTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2"/>
    </application>
</manifest>